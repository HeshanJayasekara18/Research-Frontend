# Server-only variables (no NEXT_PUBLIC_ prefix: never exposed to the browser).

# C3 Knowledge Assistant - Python FastAPI retrieval service
KNOWLEDGE_ASSISTANT_API_URL=http://127.0.0.1:8000
# Same value as RAG_SERVICE_API_KEY in the backend .env
KNOWLEDGE_ASSISTANT_API_KEY=
KNOWLEDGE_ASSISTANT_TIMEOUT_MS=15000

# DEVELOPMENT ONLY. Platform login/ownership checks are not integrated yet.
# true = allow any video ID locally. Ignored when NODE_ENV=production.
KNOWLEDGE_ASSISTANT_DEV_ALLOW_ALL_VIDEOS=false
